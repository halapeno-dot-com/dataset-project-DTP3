-- database: ./astronautdatabase.db

--all astronauts
SELECT * FROM astronauts;

--astronaut and mission names only
SELECT missions.mission_name, astronauts.name FROM astronauts
JOIN missions ON missions.missionID=astronauts.astronautID;

--longest astronaut mission
SELECT astronauts.name, astronauts.mission_count FROM astronauts
ORDER BY astronauts.mission_count DESC; 

--astronauts on the same mission
SELECT astronauts.name FROM astronauts
JOIN missions ON missions.missionID=astronauts.astronautID
WHERE missions.mission_name = 'Apollo 11';

--mission with the most astronauts
SELECT missions.mission_name, COUNT(astronauts.astronautID) AS astronaut_count FROM missions
JOIN astronauts ON astronauts.astronautID = missions.missionID
GROUP BY missions.mission_name
ORDER BY astronaut_count DESC;

--astronaut with the most missions
SELECT name, mission_count
FROM astronauts
ORDER BY mission_count DESC;

--homepage queries: astronaut ID, mission ID, astronaut name, mission name, imageURL fro astronauts and missions
SELECT astronauts.astronautID, astronauts.name, astronauts.imageURL, missions.missionID, missions.mission_name, missions.imageURL FROM astronauts
JOIN missions ON missions.missionID=astronauts.astronautID;

--one astronaut based on the ID
SELECT * FROM astronauts 
JOIN missions ON missions.missionID=astronauts.astronautID 
JOIN selections ON selections.selectionID=astronauts.astronautID
WHERE astronauts.astronautID = 2;

--one mission based on the ID
SELECT * FROM missions 
JOIN astronauts ON astronauts.astronautID=missions.missionID 
JOIN selections ON selections.selectionID=missions.missionID
WHERE missions.missionID = 2;

--making sure the multiple to mutliple relationship works
SELECT astronauts.name, missions.mission_name
FROM astronaut_missions
INNER JOIN astronauts ON astronaut_missions.astronautID=astronauts.astronautID
INNER JOIN missions ON astronaut_missions.missionID = missions.missionID
WHERE missions.mission_name = "Vostok 1";

SELECT *
,DENSE_RANK() OVER 
(PARTITION BY astronauts.FName ORDER BY astronauts.FName) AS rank
FROM astronauts;